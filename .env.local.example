# Supabase Postgres の接続文字列を設定してください。
# DATABASE_URL はアプリ実行用の pooler 接続文字列を使います。
# DIRECT_URL は Prisma migrate / Prisma Studio 用の direct 接続文字列を使います。
# 例:
# DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"

# Supabase Auth 用の公開設定です。
# Supabase Project Settings > API から取得してください。
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# アカウント削除用のサーバー専用キーです。
# ブラウザに公開されないよう、NEXT_PUBLIC_ は付けないでください。
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
