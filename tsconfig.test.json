{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "outDir": ".test-build"
  },
  "include": [
    "tests/**/*.ts",
    "lib/promptBuilder.ts",
    "lib/templates.ts",
    "lib/markdown.ts",
    "lib/aiPlanner.ts",
    "types/**/*.ts"
  ]
}
