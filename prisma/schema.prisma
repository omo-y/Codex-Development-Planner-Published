generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ProjectPlan {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  appName          String
  appIdea          String
  targetUser       String
  appType          String
  developmentStack String
  aiOption         String
  storageOption    String
  features         String
  screens          String
  extraNotes       String?
  generatedPrompt  String

  // 次バージョンでユーザー認証を追加する場合は、ここに userId を追加し、ユーザーごとの保存に対応する。
}
